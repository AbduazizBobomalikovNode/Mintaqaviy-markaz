# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. .env ni git ga qo'shmang!

# MongoDB ulanish manzili (majburiy)
URI_MONGO=

# JWT tokenlarni imzolash uchun uzun tasodifiy kalit (majburiy)
JWT_MY_KEY=

# Ishga tushirish rejimi: production yoki development
NODE_ENV=

# Server porti (ixtiyoriy, standart: 1230)
PORT=

# SMS xizmati manzili va avtorizatsiya sarlavhasi (ixtiyoriy; SMS orqali kirish uchun)
SMS_URL=
SMS_AUTH=

# Talabalarga ko'rsatiladigan yordam telefon raqami (ixtiyoriy)
SUPPORT_PHONE=
