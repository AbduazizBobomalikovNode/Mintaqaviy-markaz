  body
    // Content
    .container-xxl
      .authentication-wrapper.authentication-basic.container-p-y
        .authentication-inner
          // Register
          .card
            .card-body
              // Logo
              .app-brand.justify-content-center
                a.app-brand-link.gap-2(href='#')
                  h1.app-brand-text.text-body.fw-bolder Tizimga kirish
              // /Logo
              p.mb-4 Mintaqaviy markazga xush kelibsiz!
              form#formAuthentication.mb-3
                .mb-3.flex.items-center
                  button#dropdown-phone-button.flex-shrink-0.z-10.inline-flex.items-center.px-4.text-sm.font-medium.text-center.text-gray-900.bg-gray-100.border.border-gray-300.rounded-s-lg(data-dropdown-toggle='dropdown-phone', class='py-2.5 hover:bg-gray-200 focus:ring-4 focus:outline-none focus:ring-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 dark:focus:ring-gray-700 dark:text-white dark:border-gray-600', type='button')
                    svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 30 20', width='25', height='20')
                      // Asosiy fon
                      rect(width='30', height='20', fill='#1EB53A')
                      // Oq chiziq
                      rect(width='30', height='13.33', fill='#FFFFFF')
                      // Ko'k chiziq
                      rect(width='30', height='6.67', fill='#0099B5')
                      // Qizil chiziqlar
                      rect(y='6.67', width='30', height='0.67', fill='#D02F44')
                      rect(y='13.33', width='30', height='0.67', fill='#D02F44')
                      // Yarim oy
                      circle(cx='5', cy='3.33', r='2', fill='#FFFFFF')
                      circle(cx='5.5', cy='3.33', r='1.5', fill='#0099B5')
                      // Yulduzlar
                      g(fill='#FFFFFF')
                        circle(cx='8', cy='2', r='0.4')
                        circle(cx='9', cy='2', r='0.4')
                        circle(cx='10', cy='2', r='0.4')
                        circle(cx='11', cy='2', r='0.4')
                        circle(cx='12', cy='2', r='0.4')
                        circle(cx='8.5', cy='3', r='0.4')
                        circle(cx='9.5', cy='3', r='0.4')
                        circle(cx='10.5', cy='3', r='0.4')
                        circle(cx='11.5', cy='3', r='0.4')
                        circle(cx='9', cy='4', r='0.4')
                        circle(cx='10', cy='4', r='0.4')
                        circle(cx='11', cy='4', r='0.4')
                        |            +998 
                    svg(class="w-2.5 h-2.5 ms-2.5", aria-hidden='true', xmlns='http://www.w3.org/2000/svg', fill='none', viewBox='0 0 10 6')
                      path(stroke='currentColor', stroke-linecap='round', stroke-linejoin='round', stroke-width='2', d='m1 1 4 4 4-4')
                  #dropdown-phone.z-10.hidden.bg-white.divide-y.divide-gray-100.rounded-lg.shadow.w-52(class='dark:bg-gray-700')
                    ul.py-2.text-sm.text-gray-700(class='dark:text-gray-200', aria-labelledby='dropdown-phone-button')
                      li
                        button.inline-flex.w-full.px-4.py-2.text-sm.text-gray-700(type='button', class='hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-600 dark:hover:text-white', role='menuitem')
                          .inline-flex.items-center
                            svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 30 20', width='100', height='100')
                              // Asosiy fon
                              rect(width='30', height='20', fill='#1EB53A')
                              // Oq chiziq
                              rect(width='30', height='13.33', fill='#FFFFFF')
                              // Ko'k chiziq
                              rect(width='30', height='6.67', fill='#0099B5')
                              // Qizil chiziqlar
                              rect(y='6.67', width='30', height='0.67', fill='#D02F44')
                              rect(y='13.33', width='30', height='0.67', fill='#D02F44')
                              // Yarim oy
                              circle(cx='5', cy='3.33', r='2', fill='#FFFFFF')
                              circle(cx='5.5', cy='3.33', r='1.5', fill='#0099B5')
                              // Yulduzlar
                              g(fill='#FFFFFF')
                                circle(cx='8', cy='2', r='0.4')
                                circle(cx='9', cy='2', r='0.4')
                                circle(cx='10', cy='2', r='0.4')
                                circle(cx='11', cy='2', r='0.4')
                                circle(cx='12', cy='2', r='0.4')
                                circle(cx='8.5', cy='3', r='0.4')
                                circle(cx='9.5', cy='3', r='0.4')
                                circle(cx='10.5', cy='3', r='0.4')
                                circle(cx='11.5', cy='3', r='0.4')
                                circle(cx='9', cy='4', r='0.4')
                                circle(cx='10', cy='4', r='0.4')
                                circle(cx='11', cy='4', r='0.4')
                            |                              O'zbekiston (+998)
                  label.mb-2.text-sm.font-medium.text-gray-900.sr-only(for='phone-input', class='dark:text-white') Phone number:
                  .relative.w-full
                    input#phone-input.block.w-full.z-20.text-sm.text-gray-900.bg-gray-50.rounded-e-lg.border-s-0.border.border-gray-300(type='phone', class='p-2.5 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-s-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:border-blue-500', pattern='[0-9]{2} [0-9]{3}-[0-9]{2}-[0-9]{2}', placeholder='90 123-45-67', required='')
                .row.justify-content-center.hidden(id="kod")
                  .col-9
                    .flex.mb-2.space-x-2(class='rtl:space-x-reverse')
                      div
                        label.sr-only(for='code-1') First code
                        input#code-1.block.w-9.h-9.py-3.text-sm.font-extrabold.text-center.text-gray-900.bg-white.border.border-gray-300.rounded-lg(type='text', maxlength='1', data-focus-input-init='', data-focus-input-next='code-2', class='focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500', required='')
                      div
                        label.sr-only(for='code-2') Second code
                        input#code-2.block.w-9.h-9.py-3.text-sm.font-extrabold.text-center.text-gray-900.bg-white.border.border-gray-300.rounded-lg(type='text', maxlength='1', data-focus-input-init='', data-focus-input-prev='code-1', data-focus-input-next='code-3', class='focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500', required='')
                      div
                        label.sr-only(for='code-3') Third code
                        input#code-3.block.w-9.h-9.py-3.text-sm.font-extrabold.text-center.text-gray-900.bg-white.border.border-gray-300.rounded-lg(type='text', maxlength='1', data-focus-input-init='', data-focus-input-prev='code-2', data-focus-input-next='code-4', class='focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500', required='')
                      div
                        label.sr-only(for='code-4') Fourth code
                        input#code-4.block.w-9.h-9.py-3.text-sm.font-extrabold.text-center.text-gray-900.bg-white.border.border-gray-300.rounded-lg(type='text', maxlength='1', data-focus-input-init='', data-focus-input-prev='code-3', data-focus-input-next='code-5', class='focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500', required='')
                      div
                        label.sr-only(for='code-5') Fifth code
                        input#code-5.block.w-9.h-9.py-3.text-sm.font-extrabold.text-center.text-gray-900.bg-white.border.border-gray-300.rounded-lg(type='text', maxlength='1', data-focus-input-init='', data-focus-input-prev='code-4', data-focus-input-next='code-6', class='focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500', required='')
                      div
                        label.sr-only(for='code-6') Sixth code
                        input#code-6.block.w-9.h-9.py-3.text-sm.font-extrabold.text-center.text-gray-900.bg-white.border.border-gray-300.rounded-lg(type='text', maxlength='1', data-focus-input-init='', data-focus-input-prev='code-5', class='focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500', required='')
                  p#helper-text-explanation.mt-2.text-center(style='font-size: xx-small;')
                    | sms xabarnomasini olmagan bo&apos;lsangiz 
                    span#counter(style='font-size: x-small;') 60
                    | s dan 
                    br
                    |  keyin qayta yuborishingiz mumkin
                  p#helper-text-explanation.mt-2.text-sm.text-gray-500.text-center(class='dark:text-gray-400')
                    | Iltimos, Telefon raqamizga yuborilgan 6 xonali kodni kiriting
                .mb-3
                  button#btnsend.btn.btn-primary.text-primary.w-100(type='button') Kod yuborish
